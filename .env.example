# Package Mirror Configuration
# Copy this file to .env and fill in your values
# cp .env.example .env

# Server IP address (the machine running this stack)
SERVER_IP=192.168.1.100

# Nexus Repository Manager (npm/pnpm/pip/uv/apt)
NEXUS_PORT=8081
NEXUS_ADMIN_PASSWORD=change_me_after_first_login

# Supported formats:
# - npm/pnpm (JavaScript)
# - pip/uv (Python)
# - apt (Ubuntu/Debian)

# Cache retention: -1 = forever (no cleanup policies)
CACHE_RETENTION=-1
